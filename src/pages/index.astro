---
// Homepage. Ported from design/10xgraph/v4-runtime.html (v3 layout with the premium white CTA and
// cobalt accent). Styles live in src/styles/home.css, scoped to .home. This file is now the source of
// truth for the homepage; edit it here, not in the design prototype.
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';

const title = "10xGraph: Production-Ready Python Multi-Agent Framework";
const description = "Open-source Python multi-agent framework that generates the production server: auth, per-tool permissions, rate limits, replay-safe tools, Docker and k8s. MIT.";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "10xScale",
    "url": "https://10xscale.ai/"
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "10xGraph",
    "url": "https://10xgraph.com/"
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "10xGraph",
    "alternateName": "Agentflow",
    "description": "10xGraph is an open-source Python framework for production multi-agent AI. You write the agent, and 10xGraph generates the production server around it: authentication, per-tool permissions, rate limits, and Docker and Kubernetes deployment. Memory has two tiers, with hot data in a Redis cache and cold data in PostgreSQL. MIT licensed, made by 10xScale.",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Linux, macOS, Windows",
    "softwareVersion": "0.9.2",
    "programmingLanguage": "Python",
    "license": "https://opensource.org/licenses/MIT",
    "url": "https://10xgraph.com/",
    "codeRepository": "https://github.com/10xGraph/10xgraph",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "publisher": {
      "@type": "Organization",
      "name": "10xScale"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is 10xGraph?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "10xGraph is an open-source Python framework for building production multi-agent AI systems. You write agents as typed StateGraphs or with the prebuilt ReactAgent, and 10xGraph generates the production server around them: REST and streaming endpoints, JWT auth, owner-only threads, per-tool permissions, rate limits, and Docker and Kubernetes manifests. It is MIT licensed and made by 10xScale."
        }
      },
      {
        "@type": "Question",
        "name": "What happens if a run crashes mid-way?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "With a checkpointer configured, 10xGraph records the current node before running it and keeps a ledger of every completed tool call. When the run resumes, the interrupted node runs again, but any tool call already in the ledger is skipped instead of executed. A payment tool that finished before the crash does not charge the card a second time."
        }
      },
      {
        "@type": "Question",
        "name": "How does 10xGraph handle authentication and multi-user isolation?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The API server supports JWT or a custom auth class. The production template sets authorization to ownership, so a thread is accessible only to the user who created it, and owner checks are cached in process and in Redis. You can also restrict individual tools by role and add rate limits backed by memory or Redis."
        }
      },
      {
        "@type": "Question",
        "name": "How is 10xGraph different from LangGraph?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Both model agents as graphs. With 10xGraph, the API server, authentication, rate limits and Docker and Kubernetes manifests come from the same MIT-licensed install, and you host them yourself. LangGraph offers its managed server through LangSmith Deployment. LangGraph also requires langchain-core, while 10xGraph has no LangChain dependency."
        }
      },
      {
        "@type": "Question",
        "name": "Which LLM providers does 10xGraph support?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "10xGraph picks the provider from the model string. It supports OpenAI, Google Gemini including Vertex AI, and Anthropic through the direct API, Vertex AI or Amazon Bedrock. Any OpenAI-compatible endpoint also works. Changing the model string does not change your graph, your tools or your API endpoints."
        }
      },
      {
        "@type": "Question",
        "name": "Is 10xGraph free and open source?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. 10xGraph is released under the MIT license, including the API server and the CLI. You can use it in commercial products, self-host it on your own infrastructure and modify it. There is no hosted platform you have to buy and no account to create before you start building."
        }
      },
      {
        "@type": "Question",
        "name": "Is 10xGraph production-ready?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "10xScale runs its own AI products on 10xGraph in production. It includes replay-safe tool calls, versioned state writes, node and tool timeouts, JWT auth, owner-only threads, rate limiting and Kubernetes manifests. The core is at version 0.9.2, before 1.0, so pin your versions and read the changelog when you upgrade."
        }
      },
      {
        "@type": "Question",
        "name": "How do I install 10xGraph?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Run pip install 10xgraph 10xgraph-api on Python 3.12 or newer. Then run 10xgraph init --yes --template production to scaffold a project with auth, validators, tests and config, 10xgraph api to serve it on port 8000, and 10xgraph build --docker-compose --k8s to generate deployment files. The TypeScript client installs with npm install 10xgraph-client."
        }
      },
      {
        "@type": "Question",
        "name": "Was 10xGraph previously called Agentflow?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. 10xGraph was published as Agentflow, under the PyPI name 10xscale-agentflow, until 2026. The project was renamed because many unrelated tools share the Agentflow name. The Python import path stays the same, so existing code that imports from agentflow keeps working after you switch to the new package names."
        }
      }
    ]
  }
];
---
<BaseLayout title={title} description={description} exactTitle jsonLd={jsonLd}>
<div class="home">
<!-- HERO -->
<section class="hero" aria-labelledby="h1">
  <div class="wrap">
    <div class="hero-grid">
      <div>
        <p class="eyebrow">Open source · MIT · Python 3.12+</p>
        <h1 id="h1">Write the Python agent. 10xGraph builds the production server around it.</h1>
        <p class="sub">Authentication, per-tool permissions, rate limits, two-tier memory, replay-safe tools, and Docker and Kubernetes manifests come generated with your graph. MIT licensed and self-hosted, so the production layer is in the box.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/docs/get-started/installation">Build your first agent <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5L12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
        <div class="cta-sub">
          <button class="pill" type="button" data-copy="pip install 10xgraph 10xgraph-api" aria-label="Copy install command"><span class="prompt">$</span><code>pip install 10xgraph 10xgraph-api</code><span class="cp" aria-live="polite">Copy</span></button>
          <a class="link" href="https://github.com/10xGraph/10xgraph">Star on GitHub</a>
        </div>
      </div>

      <div class="stage" id="stage" aria-label="From code to production in five steps">
        <div class="stage-bar"><span class="live"><span class="dot"></span>code to production</span><span class="legend" aria-label="Color key"><span><i style="background:var(--you)"></i>you write</span><span><i style="background:var(--accent)"></i>10xGraph generates</span><span><i style="background:var(--infra)"></i>your infra</span></span></div>
        <ol class="rail" aria-label="Steps">
          <li><button type="button" data-go="0"><span class="n">01</span>Write<span class="bar"><i></i></span></button></li>
          <li><button type="button" data-go="1"><span class="n">02</span>Configure<span class="bar"><i></i></span></button></li>
          <li><button type="button" data-go="2"><span class="n">03</span>Serve<span class="bar"><i></i></span></button></li>
          <li><button type="button" data-go="3"><span class="n">04</span>Ship<span class="bar"><i></i></span></button></li>
          <li><button type="button" data-go="4"><span class="n">05</span>Production<span class="bar"><i></i></span></button></li>
        </ol>
        <div class="canvas">
          <svg class="flow-svg" viewBox="0 0 640 404" role="img" aria-label="From agent code to a production deployment" aria-describedby="flow-desc">
            
            <desc id="flow-desc">agent.py defines a ReactAgent, which compiles to a StateGraph with an Agent node, a ToolNode and a loop between them. agent.py then feeds 10xgraph init, which generates JWT auth, owner-only threads, a Redis rate limit and a prompt-injection validator. These plug into the generated API server on port 8000, which receives requests from a TypeScript client and runs your graph with replay-safe tools and timeouts. 10xgraph build produces Docker and Kubernetes files. State lives in a Redis hot cache and PostgreSQL cold history, and a tool ledger keeps tools replay-safe.</desc>
            <defs><pattern id="dots" width="16" height="16" patternUnits="userSpaceOnUse"><circle cx="1.5" cy="1.5" r="1" style="fill:var(--dot)"/></pattern><filter id="glow" x="-200%" y="-200%" width="500%" height="500%"><feGaussianBlur stdDeviation="2.2" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter><filter id="halo" x="-30%" y="-60%" width="160%" height="220%"><feGaussianBlur stdDeviation="4"/></filter></defs>
