---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import { absolute, getPosts, getTags, tagHref, tagSlug, type Post } from '../../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return getTags(posts).map(({ tag }) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, posts: posts.filter((p: Post) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}
const { tag, posts } = Astro.props;
const description = `Posts tagged ${tag} on the 10xGraph engineering blog: production AI agents, Python multi-agent systems and the runtime behind them.`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Blog', item: absolute('/blog') },
      { '@type': 'ListItem', position: 2, name: tag, item: absolute(tagHref(tag)) },
    ],
  },
];
---
<BaseLayout title={`Posts tagged ${tag}`} description={description} jsonLd={jsonLd}>
  <section class="wrap listing">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/blog">Blog</a><span aria-hidden="true">/</span><span>Topics</span></nav>
    <h1>{tag}</h1>
    <p class="lede">{posts.length} post{posts.length === 1 ? '' : 's'} tagged {tag}.</p>
    <PostList posts={posts} />
  </section>
</BaseLayout>
