---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import TopicNav from '../../../components/blog/TopicNav.astro';
import { absolute, getPosts, getTags, tagHref, tagSlug, type Post } from '../../../lib/content';
import '../../../styles/blog.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = getTags(posts);
  return tags.map(({ tag }) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, tags, total: posts.length, posts: posts.filter((p: Post) => p.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  tags: { tag: string; count: number }[];
  total: number;
  posts: Post[];
}
const { tag, tags, total, posts } = Astro.props;
const description = `Posts tagged ${tag} on the 10xGraph engineering blog: production AI agents, Python multi-agent systems and the runtime behind them.`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Blog', item: absolute('/blog') },
      { '@type': 'ListItem', position: 2, name: tag, item: absolute(tagHref(tag)) },
    ],
  },
];
---
<BaseLayout title={`Posts tagged ${tag}`} description={description} jsonLd={jsonLd}>
  <div class="blog">
    <header class="blog-head blog-head-tag">
      <div>
        <p class="blog-kicker"><a href="/blog">Blog</a> / topic</p>
        <h1>{tag}</h1>
        <p class="blog-intro">{posts.length} post{posts.length === 1 ? '' : 's'} about {tag}.</p>
      </div>
    </header>
    <TopicNav tags={tags} current={tag} total={total} />
    <section aria-label={`Posts tagged ${tag}`} class="post-grid-list">
      {posts.map((p) => <PostCard post={p} />)}
    </section>
  </div>
</BaseLayout>
