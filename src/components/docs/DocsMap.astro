---
// Docs navigation drawn as a graph: each page is a node on its section's line. Only the current
// section is open; the others collapse to a row of progress dots. Visited nodes are filled in by
// scripts/docs-reader.ts from localStorage. Native <details>, so it works without JS.
import { DOC_SECTIONS, MAP_HIDDEN, SECTION_INFO } from '../../lib/site';
import { docHref, type Doc } from '../../lib/content';

interface Props {
  docs: Doc[];
  /** The page being read. On a section landing page, pass `section` instead. */
  current?: Doc;
  section?: string;
}
const { docs, current, section } = Astro.props;
const openSection = current?.data.section ?? section;
const mapDocs = docs.filter((d) => !MAP_HIDDEN.includes(d.data.section));
const groups = DOC_SECTIONS.filter((s) => !MAP_HIDDEN.includes(s))
  .map((s) => ({ section: s, items: mapDocs.filter((d) => d.data.section === s) }))
  .filter((g) => g.items.length > 0);
// Pages are split into runs by their `group` frontmatter. A section with two or more groups shows
// each group as a collapsible sub-list (open when it holds the current page); a section with one
// group keeps a flat list under a label.
type Run = { group?: string; items: Doc[] };
const runsOf = (items: Doc[]): Run[] => {
  const runs: Run[] = [];
  for (const d of items) {
    const last = runs[runs.length - 1];
    if (last && last.group === d.data.group) last.items.push(d);
    else runs.push({ group: d.data.group, items: [d] });
  }
  return runs;
};
const collapsible = (runs: Run[]) => new Set(runs.filter((r) => r.group).map((r) => r.group)).size >= 2;
const DOT_LIMIT = 12;
---
<nav class="docs-map" aria-label="Documentation">
  <div class="map-head">
    <span class="map-title">Docs map</span>
    <span class="map-progress" data-map-progress data-total={mapDocs.length}>{mapDocs.length} pages</span>
  </div>
  <div class="map-sections">
    {groups.map((g) => {
      const here = g.section === openSection;
      return (
        <details class="map-section" open={here}>
          <summary>
            <span class="map-section-name">{g.section}</span>
            {g.items.length <= DOT_LIMIT ? (
              <span class="map-dots" aria-hidden="true">
                {g.items.map((d) => <i data-dot={d.id} class={d.id === current?.id ? 'is-here' : undefined} />)}
              </span>
            ) : (
              <span class="map-bar" aria-hidden="true" data-bar={g.section}><i /></span>
            )}
          </summary>
          <ol class="map-nodes">
            <li><a class="map-overview" href={`/docs/${SECTION_INFO[g.section].slug}`} aria-current={!current && here ? 'page' : undefined}>Overview</a></li>
            {(() => {
              const runs = runsOf(g.items);
              const nested = collapsible(runs);
              const node = (d: Doc) => (
                <li>
                  <a class="map-node" href={docHref(d.id)} data-doc-id={d.id} aria-current={d.id === current?.id ? 'page' : undefined} title={d.data.label ? d.data.title : undefined}>
                    <span class="map-node-dot" aria-hidden="true" />
                    <span class="map-node-label">{d.data.label ?? d.data.title}</span>
                  </a>
                </li>
              );
              return runs.map((r) =>
                nested && r.group ? (
                  <li class="map-sub">
                    <details open={r.items.some((d) => d.id === current?.id)}>
                      <summary>
                        <span class="map-sub-name">{r.group}</span>
                        <span class="map-sub-count" aria-hidden="true">{r.items.length}</span>
                      </summary>
                      <ol class="map-nodes">{r.items.map(node)}</ol>
                    </details>
                  </li>
                ) : (
                  <>
                    {r.group && <li class="map-group" aria-hidden="true">{r.group}</li>}
                    {r.items.map(node)}
                  </>
                ),
              );
            })()}
          </ol>
        </details>
      );
    })}
  </div>
  <p class="map-keys" aria-hidden="true"><kbd>[</kbd> <kbd>]</kbd> previous and next page</p>
</nav>
