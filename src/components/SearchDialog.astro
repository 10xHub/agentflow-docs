---
// Header search: a button that opens a modal (also on Ctrl/Cmd+K and "/"). Without JS the
// button is a plain link to /search.
---
<a class="search-trigger" href="/search" aria-keyshortcuts="Control+K Meta+K /">
  <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
  <span class="search-trigger-label">Search</span>
  <kbd class="search-kbd" aria-hidden="true">Ctrl K</kbd>
</a>

<dialog class="search-dialog" aria-label="Search the site">
  <div class="search-panel" data-search>
    <div class="search-field">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      <input type="search" placeholder="Search docs and blog" aria-label="Search docs and blog" autocomplete="off" spellcheck="false" />
      <button type="button" class="search-close" aria-label="Close search">Esc</button>
    </div>
    <p class="sr-status" role="status" aria-live="polite"></p>
    <ul class="sr-list"></ul>
    <p class="search-hints" aria-hidden="true"><kbd>↑</kbd><kbd>↓</kbd> to move <kbd>Enter</kbd> to open <kbd>Esc</kbd> to close</p>
  </div>
</dialog>

<script>
  import { mountSearch } from '../scripts/search';

  const dialog = document.querySelector<HTMLDialogElement>('.search-dialog')!;
  const trigger = document.querySelector<HTMLAnchorElement>('.search-trigger')!;
  const { input, run } = mountSearch(dialog.querySelector('[data-search]')!);
  const isMac = /Mac|iPhone|iPad/.test(navigator.userAgent);
  trigger.querySelector('.search-kbd')!.textContent = isMac ? '⌘ K' : 'Ctrl K';

  function open() {
    if (dialog.open) return;
    dialog.showModal();
    input.select();
    run(input.value);
  }
  trigger.addEventListener('click', (e) => {
    e.preventDefault();
    open();
  });
  dialog.querySelector('.search-close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('.sr-list a')) dialog.close();
  });
  document.addEventListener('keydown', (e) => {
    const typing = (e.target as HTMLElement).closest('input, textarea, select, [contenteditable="true"]');
    if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
      e.preventDefault();
      open();
    }
  });
</script>
