---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import AiNote from '../components/AiNote.astro';
import Faq from '../components/Faq.astro';
import Toc from '../components/Toc.astro';
import PostCard from '../components/blog/PostCard.astro';
import PostCover from '../components/blog/PostCover.astro';
import { SITE } from '../lib/site';
import { AUTHORS, initials } from '../lib/authors';
import {
  absolute,
  faqJsonLd,
  formatDate,
  postHref,
  postMarkdownHref,
  readingMinutes,
  tagHref,
  type Post,
} from '../lib/content';
import '../styles/blog.css';

interface Props {
  entry: Post;
  headings: MarkdownHeading[];
  posts: Post[];
}
const { entry, headings, posts } = Astro.props;
const { title, description, date, updated, author, tags, faq } = entry.data;
const href = postHref(entry.id);
const url = absolute(href);
const markdownHref = postMarkdownHref(entry.id);
const role = AUTHORS[author]?.role;
const minutes = readingMinutes(entry.body);

// Keep reading: posts sharing the most tags first, then the newest.
const related = posts
  .filter((p) => p.id !== entry.id)
  .map((p) => ({ p, shared: p.data.tags.filter((t) => tags.includes(t)).length }))
  .sort((a, b) => b.shared - a.shared || b.p.data.date.getTime() - a.p.data.date.getTime())
  .slice(0, 2)
  .map((r) => r.p);

const share = [
  { label: 'X', href: `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}` },
  { label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}` },
  { label: 'Hacker News', href: `https://news.ycombinator.com/submitlink?u=${encodeURIComponent(url)}&t=${encodeURIComponent(title)}` },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    url,
    mainEntityOfPage: url,
    datePublished: date.toISOString(),
    dateModified: (updated ?? date).toISOString(),
    author: { '@type': 'Person', name: author, ...(role && { jobTitle: role }) },
    publisher: { '@type': 'Organization', name: SITE.org.name, url: SITE.org.url },
    keywords: tags.join(', '),
    wordCount: (entry.body ?? '').split(/\s+/).length,
    isPartOf: { '@type': 'Blog', name: `${SITE.name} blog`, url: absolute('/blog') },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Blog', item: absolute('/blog') },
      { '@type': 'ListItem', position: 2, name: title, item: url },
    ],
  },
  ...(faq.length ? [faqJsonLd(faq)] : []),
];
---
<BaseLayout
  title={title}
  description={description}
  ogType="article"
  jsonLd={jsonLd}
  markdownHref={markdownHref}
  publishedTime={date}
  modifiedTime={updated ?? date}
>
  <div class="read-progress" aria-hidden="true"><span></span></div>

  <article class="story" data-pagefind-body>
    <header class="story-head">
      <nav class="story-crumbs" aria-label="Breadcrumb" data-pagefind-ignore>
        <a href="/blog">Blog</a>
        {tags.slice(0, 3).map((t) => <a class="story-tag" href={tagHref(t)}>{t}</a>)}
      </nav>
      <h1>{title}</h1>
      <p class="story-dek">{description}</p>
      <div class="byline">
        <span class="avatar" aria-hidden="true">{initials(author)}</span>
        <span class="byline-text">
          <span class="byline-name">{author}</span>
          <span class="byline-meta">
            {role && <span>{role}</span>}
            <time datetime={date.toISOString()}>{formatDate(date)}</time>
            <span>{minutes} min read</span>
            {updated && <span>Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></span>}
            <a href={markdownHref} rel="alternate" type="text/markdown" title="This post as plain Markdown, for AI agents">Markdown</a>
          </span>
        </span>
      </div>
    </header>

    <figure class="story-cover" aria-hidden="true">
      <PostCover seed={entry.id} variant="hero" animate />
    </figure>

    <div class="story-grid">
      <aside class="story-toc" data-pagefind-ignore>
        <Toc headings={headings} hasFaq={faq.length > 0} />
      </aside>
      <div class="story-main">
        <div class="prose story-prose">
          <slot />
        </div>
        <Faq faq={faq} />

        <footer class="story-end" data-pagefind-ignore>
          {tags.length > 0 && (
            <ul class="story-tags" aria-label="Tags">
              {tags.map((t) => <li><a href={tagHref(t)}>{t}</a></li>)}
            </ul>
          )}
          <div class="author-card">
            <span class="avatar avatar-lg" aria-hidden="true">{initials(author)}</span>
            <div>
              <p class="author-kicker">Written by</p>
              <p class="author-name">{author}</p>
              {role && <p class="author-role">{role}</p>}
            </div>
          </div>
          <div class="share">
            <span class="share-label">Share</span>
            <button type="button" class="share-btn" data-copy-link={url}>Copy link</button>
            {share.map((s) => <a class="share-btn" href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
          </div>
          <AiNote markdownHref={markdownHref} kind="post" />
        </footer>
      </div>
    </div>
  </article>

  <section class="more" aria-labelledby="more-title" data-pagefind-ignore>
    <div class="more-head">
      <h2 id="more-title">Keep reading</h2>
      <a href="/rss.xml" class="more-rss">Subscribe via RSS</a>
    </div>
    {related.length > 0 && (
      <div class="post-grid-list">
        {related.map((p) => <PostCard post={p} headingLevel="h3" />)}
      </div>
    )}
    <p class="more-all"><a href="/blog">Blog home</a> <span aria-hidden="true">·</span> <a href="/blog/archive">Archive</a></p>
  </section>
</BaseLayout>

<script>
  // Reading progress along the top edge, and the "Copy link" share button.
  const bar = document.querySelector<HTMLElement>('.read-progress span');
  const story = document.querySelector<HTMLElement>('.story-prose');
  if (bar && story) {
    let ticking = false;
    const update = () => {
      const r = story.getBoundingClientRect();
      const total = r.height - window.innerHeight * 0.6;
      const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
      bar.style.transform = `scaleX(${p})`;
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }, { passive: true });
    update();
  }
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copyLink!);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Copy failed';
      }
      setTimeout(() => (btn.textContent = 'Copy link'), 1600);
    });
  });
</script>
