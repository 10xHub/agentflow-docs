{
  "name": "10xgraph-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Documentation and blog for 10xGraph. Static Astro site built for search and AI readability.",
  "scripts": {
    "dev": "npm run search:index && astro dev",
    "dev:fast": "astro dev",
    "build": "astro build && pagefind --site dist",
    "search:index": "astro build && pagefind --site dist --output-path public/pagefind",
    "preview": "astro preview",
    "check": "astro check",
    "contributors": "node scripts/fetch-contributors.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@shikijs/transformers": "^4.5.0",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3"
  }
}
